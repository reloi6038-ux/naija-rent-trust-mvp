/* ============================================================
   Homepage-only premium styles. Dark aurora theme.
   Does NOT override style.css — augments it.
   ============================================================ */

/* ---------- Animated aurora body ---------- */
body.home {
  background: #020617;
  color: #e2e8f0;
  position: relative;
  overflow-x: hidden;
  --aurora-1: #1d4ed8;
  --aurora-2: #7c3aed;
  --aurora-3: #16a34a;
  --aurora-4: #db2777;
}

/* Deep-space base gradient */
body.home::before {
  content: "";
  position: fixed;
  inset: 0;
  z-index: -3;
  background:
    radial-gradient(ellipse 80% 60% at 50% 0%, #0b1220 0%, #020617 70%),
    linear-gradient(180deg, #020617 0%, #0b1220 100%);
}

/* Animated color blobs */
body.home::after {
  content: "";
  position: fixed;
  inset: -10%;
  z-index: -2;
  background:
    radial-gradient(circle at 15% 25%, rgba(29,78,216,.35), transparent 45%),
    radial-gradient(circle at 85% 20%, rgba(124,58,237,.30), transparent 45%),
    radial-gradient(circle at 20% 80%, rgba(22,163,74,.25), transparent 45%),
    radial-gradient(circle at 80% 85%, rgba(219,39,119,.28), transparent 45%);
  filter: blur(60px);
  animation: auroraDrift 24s ease-in-out infinite alternate;
  pointer-events: none;
}

@keyframes auroraDrift {
  0%   { transform: translate(0,0) scale(1)   rotate(0deg); }
  33%  { transform: translate(3%,-2%) scale(1.06) rotate(1deg); }
  66%  { transform: translate(-2%,3%) scale(.98) rotate(-1deg); }
  100% { transform: translate(2%,2%) scale(1.04) rotate(0deg); }
}

/* Floating particles layer */
.particles {
  position: fixed;
  inset: 0;
  z-index: -1;
  pointer-events: none;
  overflow: hidden;
}
.particle {
  position: absolute;
  bottom: -20px;
  width: 4px;
  height: 4px;
  border-radius: 50%;
  background: rgba(255,255,255,.6);
  box-shadow: 0 0 8px rgba(255,255,255,.4);
  animation: floatUp linear infinite;
}
@keyframes floatUp {
  from { transform: translateY(0) translateX(0); opacity: 0; }
  10%  { opacity: .8; }
  90%  { opacity: .6; }
  to   { transform: translateY(-110vh) translateX(var(--drift,0px)); opacity: 0; }
}

/* ---------- Nav: dark glass ---------- */
.home .nav {
  background: rgba(2,6,23,.55);
  border-bottom: 1px solid rgba(148,163,184,.15);
  backdrop-filter: saturate(180%) blur(20px);
  -webkit-backdrop-filter: saturate(180%) blur(20px);
}
.home .nav.scrolled { background: rgba(2,6,23,.85); box-shadow: 0 10px 30px rgba(0,0,0,.4); }
.home .brand, .home .nav-links a { color: #e2e8f0; }
.home .nav-links a:hover { background: rgba(148,163,184,.12); color: #fff; }
.home .nav-links a.active { background: rgba(37,99,235,.2); color: #93c5fd; }
.home .nav-toggle { background: rgba(148,163,184,.1); border-color: rgba(148,163,184,.2); color: #e2e8f0; }

/* ---------- Hero ---------- */
.hero-premium {
  position: relative;
  padding: 120px 0 90px;
  color: #fff;
  isolation: isolate;
}

/* Rotating gradient ring */
@property --angle {
  syntax: '<angle>';
  initial-value: 0deg;
  inherits: false;
}

.hero-card {
  position: relative;
  padding: 2px;
  border-radius: 24px;
  background:
    conic-gradient(from var(--angle),
      rgba(59,130,246,.9),
      rgba(124,58,237,.9),
      rgba(22,163,74,.9),
      rgba(219,39,119,.9),
      rgba(59,130,246,.9));
  animation: spinRing 12s linear infinite;
  box-shadow: 0 30px 80px rgba(37,99,235,.25);
}
@keyframes spinRing { to { --angle: 360deg; } }

.hero-card-inner {
  background: rgba(2,6,23,.82);
  backdrop-filter: blur(24px);
  -webkit-backdrop-filter: blur(24px);
  border-radius: 22px;
  padding: 44px 40px;
  position: relative;
  overflow: hidden;
}
.hero-card-inner::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(circle at 20% 20%, rgba(59,130,246,.15), transparent 40%),
              radial-gradient(circle at 80% 80%, rgba(22,163,74,.12), transparent 40%);
  pointer-events: none;
}

.hero-eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 8px 16px;
  border-radius: 999px;
  background: rgba(34,197,94,.15);
  border: 1px solid rgba(34,197,94,.35);
  color: #86efac;
  font-size: .8rem;
  font-weight: 700;
  letter-spacing: .04em;
  margin-bottom: 24px;
  backdrop-filter: blur(8px);
}
.hero-eyebrow::before {
  content: "";
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #22c55e;
  box-shadow: 0 0 12px #22c55e;
  animation: pulseDot 1.8s ease-in-out infinite;
}
@keyframes pulseDot {
  0%, 100% { opacity: 1; transform: scale(1); }
  50% { opacity: .5; transform: scale(1.4); }
}

.hero-h1 {
  font-size: clamp(2rem, 5vw, 3.6rem);
  line-height: 1.08;
  letter-spacing: -.03em;
  margin: 0 0 20px;
  color: #fff;
  min-height: 1.1em;
}
.hero-h1 .static { display: block; color: #fff; }
.hero-h1 .typed {
  background: linear-gradient(135deg, #60a5fa, #a78bfa, #f472b6, #4ade80);
  background-size: 300% 300%;
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  animation: gradientShift 8s ease infinite;
}
@keyframes gradientShift {
  0%, 100% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
}

.cursor {
  display: inline-block;
  width: 3px;
  height: 1em;
  background: #60a5fa;
  margin-left: 6px;
  vertical-align: -0.1em;
  animation: blink 1s step-end infinite;
  box-shadow: 0 0 12px #60a5fa;
}
@keyframes blink { 50% { opacity: 0; } }

.hero-sub {
  color: #94a3b8;
  font-size: 1.1rem;
  max-width: 620px;
  margin: 0 0 34px;
  line-height: 1.65;
}

/* ---------- Search form ---------- */
.search-premium {
  display: grid;
  grid-template-columns: 1.4fr 1fr 1fr auto;
  gap: 12px;
  background: rgba(15,23,42,.7);
  border: 1px solid rgba(148,163,184,.15);
  border-radius: 16px;
  padding: 10px;
  backdrop-filter: blur(16px);
}
@media (max-width: 860px) { .search-premium { grid-template-columns: 1fr; } }

.search-premium .field {
  position: relative;
  padding: 8px 14px;
  border-radius: 10px;
  background: rgba(2,6,23,.6);
  border: 1px solid rgba(148,163,184,.1);
  transition: border-color .25s, box-shadow .25s;
}
.search-premium .field:focus-within {
  border-color: rgba(96,165,250,.6);
  box-shadow: 0 0 0 4px rgba(59,130,246,.12);
}
.search-premium .field label {
  position: static;
  display: block;
  font-size: .68rem;
  text-transform: uppercase;
  letter-spacing: .1em;
  color: #64748b;
  font-weight: 700;
  margin-bottom: 2px;
}
.search-premium .field input,
.search-premium .field select {
  width: 100%;
  padding: 4px 0;
  border: none;
  background: transparent;
  color: #f1f5f9;
  font: inherit;
  font-size: .95rem;
  outline: none;
}
.search-premium .field input::placeholder { color: #475569; }
.search-premium .field input:focus,
.search-premium .field select:focus { outline: none; box-shadow: none; border: none; }

.search-premium .btn {
  align-self: stretch;
  padding: 16px 26px;
  border-radius: 10px;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #fff;
  font-weight: 700;
  border: none;
  position: relative;
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(37,99,235,.4);
  transition: transform .25s, box-shadow .25s;
}
.search-premium .btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 40px rgba(37,99,235,.6);
}
.search-premium .btn::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,.3) 50%, transparent 70%);
  transform: translateX(-100%);
  transition: transform .6s;
}
.search-premium .btn:hover::after { transform: translateX(100%); }

/* ---------- Hero stats ---------- */
.hero-metrics {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
  margin-top: 44px;
  padding-top: 34px;
  border-top: 1px solid rgba(148,163,184,.15);
}
@media (max-width: 640px) { .hero-metrics { grid-template-columns: 1fr; } }

.metric .v {
  font-size: 2rem;
  font-weight: 800;
  letter-spacing: -.02em;
  background: linear-gradient(135deg, #60a5fa, #a78bfa);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}
.metric .l {
  color: #64748b;
  font-size: .82rem;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: .08em;
  margin-top: 4px;
}

/* ---------- Trust marquee ---------- */
.trust-ribbon {
  overflow: hidden;
  padding: 22px 0;
  border-top: 1px solid rgba(148,163,184,.1);
  border-bottom: 1px solid rgba(148,163,184,.1);
  background: rgba(2,6,23,.5);
}
.trust-track {
  display: flex;
  gap: 60px;
  width: max-content;
  animation: marquee 40s linear infinite;
}
.trust-ribbon:hover .trust-track { animation-play-state: paused; }
.trust-item {
  display: flex;
  align-items: center;
  gap: 10px;
  color: #94a3b8;
  font-size: .88rem;
  font-weight: 600;
  white-space: nowrap;
  opacity: .85;
}
.trust-item::before {
  content: "✓";
  color: #22c55e;
  font-weight: 900;
  font-size: 1rem;
}
@keyframes marquee {
  from { transform: translateX(0); }
  to { transform: translateX(-50%); }
}

/* ---------- Section base ---------- */
.section-premium {
  padding: 96px 0;
  position: relative;
}
.section-premium .eyebrow {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  font-size: .78rem;
  font-weight: 700;
  letter-spacing: .14em;
  text-transform: uppercase;
  color: #60a5fa;
  margin-bottom: 16px;
}
.section-premium .eyebrow::before {
  content: "";
  width: 24px;
  height: 2px;
  background: #60a5fa;
  border-radius: 2px;
}
.section-premium h2 {
  color: #fff;
  font-size: clamp(1.6rem, 3vw, 2.4rem);
  margin-bottom: 12px;
}
.section-premium .section-sub {
  color: #64748b;
  font-size: 1.05rem;
  max-width: 620px;
  margin-bottom: 44px;
}

/* ---------- Feature cards ---------- */
.feature-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
  gap: 24px;
}
.feature-card {
  position: relative;
  padding: 32px 28px;
  background: linear-gradient(160deg, rgba(15,23,42,.9), rgba(2,6,23,.9));
  border: 1px solid rgba(148,163,184,.12);
  border-radius: 20px;
  overflow: hidden;
  transition: transform .35s, border-color .35s, box-shadow .35s;
}
.feature-card::before {
  content: "";
  position: absolute;
  inset: 0;
  background: radial-gradient(600px circle at var(--mx,50%) var(--my,50%), rgba(96,165,250,.12), transparent 40%);
  opacity: 0;
  transition: opacity .35s;
  pointer-events: none;
}
.feature-card:hover {
  transform: translateY(-4px);
  border-color: rgba(96,165,250,.3);
  box-shadow: 0 30px 60px rgba(2,6,23,.6), 0 0 0 1px rgba(96,165,250,.1);
}
.feature-card:hover::before { opacity: 1; }

.feature-icon {
  width: 56px;
  height: 56px;
  border-radius: 14px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 1.6rem;
  margin-bottom: 18px;
  background: linear-gradient(135deg, rgba(96,165,250,.2), rgba(167,139,250,.2));
  border: 1px solid rgba(96,165,250,.3);
  position: relative;
  z-index: 1;
}
.feature-card h3 {
  color: #fff;
  margin: 0 0 10px;
  font-size: 1.15rem;
  position: relative;
  z-index: 1;
}
.feature-card p {
  color: #94a3b8;
  margin: 0;
  font-size: .95rem;
  line-height: 1.6;
  position: relative;
  z-index: 1;
}

/* ---------- Steps timeline ---------- */
.steps {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 24px;
  position: relative;
}
.step-card {
  position: relative;
  padding: 30px 24px;
  background: rgba(15,23,42,.6);
  border: 1px solid rgba(148,163,184,.12);
  border-radius: 18px;
  backdrop-filter: blur(10px);
  transition: transform .35s, border-color .35s;
}
.step-card:hover {
  transform: translateY(-4px);
  border-color: rgba(167,139,250,.3);
}
.step-num {
  width: 48px;
  height: 48px;
  border-radius: 12px;
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 800;
  font-size: 1.1rem;
  margin-bottom: 18px;
  box-shadow: 0 10px 24px rgba(37,99,235,.35);
}
.step-card h3 {
  color: #fff;
  margin: 0 0 8px;
  font-size: 1.1rem;
}
.step-card p {
  color: #94a3b8;
  margin: 0;
  font-size: .93rem;
  line-height: 1.6;
}

/* ---------- Testimonials ---------- */
.testimonial-stage {
  position: relative;
  min-height: 240px;
  display: flex;
  align-items: center;
  justify-content: center;
}
.testimonial {
  max-width: 720px;
  text-align: center;
  opacity: 0;
  transform: translateY(20px);
  transition: opacity .5s, transform .5s;
  position: absolute;
  top: 50%;
  left: 50%;
  width: 100%;
  padding: 0 20px;
  transform: translate(-50%, -50%) translateY(20px);
}
.testimonial.active {
  opacity: 1;
  transform: translate(-50%, -50%) translateY(0);
  position: relative;
  top: auto;
  left: auto;
}
.testimonial blockquote {
  font-size: clamp(1.1rem, 2.2vw, 1.45rem);
  line-height: 1.5;
  color: #e2e8f0;
  margin: 0 0 24px;
  font-weight: 500;
  letter-spacing: -.01em;
}
.testimonial blockquote::before {
  content: "";
  display: block;
  width: 40px;
  height: 3px;
  background: linear-gradient(90deg, #60a5fa, #a78bfa);
  margin: 0 auto 22px;
  border-radius: 2px;
}
.testimonial-author {
  display: inline-flex;
  align-items: center;
  gap: 12px;
  color: #94a3b8;
  font-size: .9rem;
}
.testimonial-author .avatar {
  width: 40px;
  height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, #60a5fa, #a78bfa);
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-weight: 800;
  font-size: .9rem;
}
.testimonial-dots {
  display: flex;
  justify-content: center;
  gap: 8px;
  margin-top: 30px;
}
.testimonial-dot {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: rgba(148,163,184,.3);
  border: none;
  cursor: pointer;
  transition: all .25s;
  padding: 0;
}
.testimonial-dot.active {
  background: linear-gradient(135deg, #60a5fa, #a78bfa);
  width: 28px;
  border-radius: 6px;
}

/* ---------- CTA panel ---------- */
.cta-premium {
  position: relative;
  padding: 80px 40px;
  text-align: center;
  border-radius: 24px;
  overflow: hidden;
  background: linear-gradient(135deg, rgba(29,78,216,.3), rgba(124,58,237,.25), rgba(219,39,119,.2));
  border: 1px solid rgba(96,165,250,.3);
}
.cta-premium::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 20% 30%, rgba(96,165,250,.3), transparent 40%),
    radial-gradient(circle at 80% 70%, rgba(167,139,250,.25), transparent 40%);
  animation: auroraDrift 20s ease-in-out infinite alternate;
  pointer-events: none;
}
.cta-premium > * { position: relative; z-index: 1; }
.cta-premium h2 {
  color: #fff;
  font-size: clamp(1.8rem, 3.5vw, 2.6rem);
  margin: 0 0 14px;
  letter-spacing: -.02em;
}
.cta-premium p {
  color: #cbd5e1;
  font-size: 1.1rem;
  max-width: 560px;
  margin: 0 auto 30px;
}
.cta-premium .btn {
  padding: 16px 36px;
  border-radius: 12px;
  background: linear-gradient(135deg, #fff, #f1f5f9);
  color: #0f172a;
  font-weight: 700;
  font-size: 1rem;
  border: none;
  box-shadow: 0 20px 40px rgba(0,0,0,.3);
  transition: transform .25s, box-shadow .25s;
}
.cta-premium .btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 24px 50px rgba(0,0,0,.4);
}

/* ---------- Featured listings section ---------- */
.home .property-card {
  background: rgba(15,23,42,.7);
  border-color: rgba(148,163,184,.15);
  backdrop-filter: blur(10px);
}
.home .property-card:hover {
  border-color: rgba(96,165,250,.3);
  box-shadow: 0 30px 60px rgba(2,6,23,.6);
}
.home .property-card .card-title { color: #fff; }
.home .property-card .card-loc { color: #64748b; }
.home .property-card .card-meta { color: #94a3b8; }
.home .property-card .card-price { color: #60a5fa; }

/* ---------- Footer ---------- */
.home .footer {
  background: #020617;
  border-top: 1px solid rgba(148,163,184,.1);
}
.home .footer p, .home .footer a { color: #94a3b8; }
.home .footer h4 { color: #fff; }
.home .footer a:hover { color: #60a5fa; }
.home .footer .brand { color: #fff; }

/* ---------- Reduced motion ---------- */
@media (prefers-reduced-motion: reduce) {
  body.home::after,
  .particle,
  .hero-card,
  .trust-track,
  .cta-premium::before { animation: none !important; }
  .cursor { animation: none; }
  .hero-h1 .typed { animation: none; background: #60a5fa; -webkit-background-clip: initial; background-clip: initial; color: #60a5fa; }
}

/* ============================================================
   FIX: Nav buttons on dark background
   ============================================================ */
.home .nav .btn-ghost {
  background: rgba(148, 163, 184, 0.08);
  border: 1px solid rgba(148, 163, 184, 0.35);
  color: #e2e8f0;
}
.home .nav .btn-ghost:hover {
  background: rgba(96, 165, 250, 0.15);
  border-color: rgba(96, 165, 250, 0.7);
  color: #93c5fd;
}

.home .nav .btn-primary {
  background: linear-gradient(135deg, #2563eb, #7c3aed);
  color: #ffffff;
  border: none;
  box-shadow: 0 6px 20px rgba(37, 99, 235, 0.35);
}
.home .nav .btn-primary:hover {
  box-shadow: 0 10px 28px rgba(37, 99, 235, 0.5);
  transform: translateY(-1px);
}

/* ============================================================
   MOBILE OPTIMIZATION
   ============================================================ */

/* Global touch sizing on mobile */
@media (max-width: 860px) {
  .home .nav-actions .btn {
    min-height: 40px;
    padding: 10px 16px;
    font-size: 0.88rem;
  }
  .home .btn:not(.btn-sm) {
    min-height: 46px;
    padding: 12px 22px;
    font-size: 0.95rem;
  }
}

/* Hero: fluid paddings */
@media (max-width: 860px) {
  .hero-premium { padding: 72px 0 48px; }
  .hero-card-inner { padding: 32px 24px; border-radius: 18px; }
  .hero-card { border-radius: 20px; }
}

@media (max-width: 640px) {
  .hero-premium { padding: 56px 0 36px; }
  .hero-card-inner { padding: 24px 18px; }
  .hero-h1 { font-size: clamp(1.7rem, 7vw, 2.4rem); }
  .hero-sub { font-size: 1rem; margin-bottom: 24px; }
  .hero-eyebrow { font-size: 0.72rem; padding: 6px 12px; margin-bottom: 18px; }
}

/* Search form: full-width stacking on mobile */
@media (max-width: 860px) {
  .search-premium {
    grid-template-columns: 1fr;
    padding: 12px;
    gap: 8px;
  }
  .search-premium .field { padding: 10px 14px; }
  .search-premium .btn {
    padding: 14px 20px;
    width: 100%;
  }
}

/* Hero metrics: stack on small screens */
@media (max-width: 560px) {
  .hero-metrics {
    grid-template-columns: 1fr;
    gap: 16px;
    margin-top: 28px;
    padding-top: 24px;
    text-align: left;
  }
  .metric .v { font-size: 1.6rem; }
  .metric .l { font-size: 0.75rem; }
}

/* Trust ribbon: slower + smaller on mobile */
@media (max-width: 640px) {
  .trust-ribbon { padding: 16px 0; }
  .trust-track { gap: 40px; animation-duration: 30s; }
  .trust-item { font-size: 0.78rem; }
}

/* Section paddings */
@media (max-width: 860px) {
  .section-premium { padding: 64px 0; }
  .section-premium .section-sub { margin-bottom: 32px; font-size: 0.98rem; }
}
@media (max-width: 560px) {
  .section-premium { padding: 48px 0; }
  .section-premium h2 { font-size: 1.5rem; }
}

/* Feature grid: single column on phones */
@media (max-width: 640px) {
  .feature-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  .feature-card { padding: 24px 20px; }
  .feature-icon { width: 48px; height: 48px; font-size: 1.35rem; margin-bottom: 14px; }
  .feature-card h3 { font-size: 1.05rem; }
  .feature-card p { font-size: 0.9rem; }
}

/* Steps: stack vertically on phones, tighter spacing */
@media (max-width: 640px) {
  .steps { grid-template-columns: 1fr; gap: 16px; }
  .step-card { padding: 24px 20px; }
  .step-num { width: 42px; height: 42px; font-size: 1rem; margin-bottom: 14px; }
}

/* Featured listings: single column on phones */
@media (max-width: 640px) {
  .home .grid-3 {
    grid-template-columns: 1fr;
    gap: 18px;
  }
  .home .property-card .card-body { padding: 16px 18px 18px; }
  .home .property-card .card-price { font-size: 1.2rem; }
}

/* Testimonials: tighter text + larger touch dots */
@media (max-width: 640px) {
  .testimonial-stage { min-height: 260px; }
  .testimonial { padding: 0 12px; }
  .testimonial blockquote { font-size: 1.05rem; }
  .testimonial-author { font-size: 0.82rem; }
  .testimonial-dots { gap: 12px; margin-top: 24px; }
  .testimonial-dot {
    width: 12px;
    height: 12px;
    padding: 0;
  }
  .testimonial-dot.active { width: 32px; }
}

/* CTA panel: tighter on phones */
@media (max-width: 640px) {
  .cta-premium {
    padding: 52px 22px;
    border-radius: 20px;
  }
  .cta-premium h2 { font-size: 1.5rem; }
  .cta-premium p { font-size: 1rem; margin-bottom: 22px; }
  .cta-premium .btn { padding: 14px 28px; font-size: 0.95rem; }
}

/* Footer: 2-column → 1-column on phones */
@media (max-width: 640px) {
  .home .footer { padding: 44px 0 20px; margin-top: 48px; }
  .home .footer-grid {
    grid-template-columns: 1fr;
    gap: 28px;
    text-align: left;
  }
  .home .footer h4 { margin-bottom: 10px; }
  .home .footer-bottom { margin-top: 28px; padding-top: 16px; font-size: 0.78rem; line-height: 1.5; }
}

/* Mobile nav drawer: proper full-screen treatment */
@media (max-width: 860px) {
  .home .nav-links {
    background: rgba(2, 6, 23, 0.97);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(148, 163, 184, 0.15);
    padding: 16px;
    gap: 6px;
  }
  .home .nav-links a {
    padding: 14px 16px;
    font-size: 1rem;
    border-radius: 10px;
    color: #e2e8f0;
  }
  .home .nav-links a:hover,
  .home .nav-links a.active {
    background: rgba(96, 165, 250, 0.12);
    color: #93c5fd;
  }

  /* Keep nav actions visible above the drawer */
  .home .nav-actions {
    display: flex !important;
    gap: 8px;
  }
  .home .nav-actions .btn {
    padding: 9px 14px;
    font-size: 0.82rem;
    min-height: 38px;
  }

  /* Hide the "Post a Property" primary button on very narrow screens
     to avoid crowding — the dashboard/login stays reachable via drawer */
  .home .nav-toggle {
    background: rgba(148, 163, 184, 0.1);
    border-color: rgba(148, 163, 184, 0.25);
    color: #e2e8f0;
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }
  .home .nav-toggle:hover {
    background: rgba(96, 165, 250, 0.15);
    border-color: rgba(96, 165, 250, 0.5);
  }
}

@media (max-width: 480px) {
  /* On phones: collapse the primary nav CTA to save space */
  .home .nav-actions .btn-primary {
    display: none;
  }
  .home .nav-actions .btn-ghost {
    font-size: 0.78rem;
    padding: 8px 12px;
    min-height: 36px;
  }
}

/* Motion safety — disable all custom hero animations on reduced-motion */
@media (prefers-reduced-motion: reduce) {
  .hero-card { animation: none !important; }
  .trust-track { animation: none !important; }
  .testimonial { transition: none !important; }
}

/* Touch-device hover suppression (avoid stuck hover states) */
@media (hover: none) {
  .feature-card:hover,
  .step-card:hover,
  .home .property-card:hover,
  .search-premium .btn:hover,
  .cta-premium .btn:hover {
    transform: none;
    box-shadow: none;
  }
  .feature-card::before { display: none; }
}

/* Logo visibility on dark nav */
.home .brand img,
.home .brand .brand-mark {
  box-shadow: 0 0 0 1px rgba(148, 163, 184, 0.25), 0 6px 16px rgba(37, 99, 235, 0.35);
  border-radius: 9px;
}

/* Brand text on dark nav */
.home .brand {
  color: #ffffff;
}
.home .brand em {
  color: #60a5fa;
}

/* ============================================================
   FIX: Nav buttons visibility + drawer behavior
   ============================================================ */

/* Ensure nav buttons always show on desktop/tablet */
.home .nav-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

/* Mobile drawer: full-height, scrollable, blocks body scroll */
@media (max-width: 860px) {
  .home .nav-links {
    position: fixed;
    top: var(--nav-h);
    left: 0;
    right: 0;
    max-height: calc(100vh - var(--nav-h));
    overflow-y: auto;
    background: rgba(2, 6, 23, 0.98);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    border-bottom: 1px solid rgba(148, 163, 184, 0.15);
    padding: 16px;
    gap: 6px;
    display: flex;
    flex-direction: column;
    align-items: stretch;
    transform: translateY(-12px);
    opacity: 0;
    pointer-events: none;
    transition: transform 0.28s ease, opacity 0.28s ease;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.6);
  }

  .home .nav-links.open {
    transform: translateY(0);
    opacity: 1;
    pointer-events: auto;
  }

  .home .nav-links a {
    padding: 14px 16px;
    font-size: 1rem;
    border-radius: 10px;
    color: #e2e8f0;
    font-weight: 600;
  }

  .home .nav-links a:hover,
  .home .nav-links a.active {
    background: rgba(96, 165, 250, 0.12);
    color: #93c5fd;
  }

  .home .nav-actions {
    display: flex !important;
    gap: 8px;
  }
  .home .nav-actions .btn {
    padding: 9px 14px;
    font-size: 0.82rem;
    min-height: 38px;
  }

  .home .nav-toggle {
    background: rgba(148, 163, 184, 0.1);
    border: 1px solid rgba(148, 163, 184, 0.25);
    color: #e2e8f0;
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 10px;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .home .nav-toggle:hover,
  .home .nav-toggle:focus-visible {
    background: rgba(96, 165, 250, 0.15);
    border-color: rgba(96, 165, 250, 0.5);
  }
}

/* On tiny phones: hide inline primary in the top bar (it now lives in the drawer) */
@media (max-width: 480px) {
  .home .nav-actions .btn-primary:not(.mobile-cta) {
    display: none;
  }
  .home .nav-actions .btn-ghost {
    font-size: 0.78rem;
    padding: 8px 12px;
    min-height: 36px;
  }
  .home .nav-links .mobile-cta {
    display: block !important;
    width: 100%;
    text-align: center;
    margin-top: 12px;
    background: linear-gradient(135deg, #2563eb, #7c3aed);
    color: #fff;
    padding: 12px 18px;
    border-radius: 10px;
    font-weight: 700;
  }
}
