# ---- Core ----
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASS@cluster.mongodb.net/naija_rent?retryWrites=true&w=majority
JWT_SECRET=change-me-long-random-string
JWT_REFRESH_SECRET=change-me-another-long-random-string
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# ---- Admin bootstrap ----
ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=ChangeMe123!

# ---- Email (Resend via SMTP) ----
# In dev, leave MAIL_TRANSPORT=console so emails print to the log
MAIL_TRANSPORT=console
MAIL_FROM="NaijaRent <noreply@yourdomain.com>"
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=

# ---- Monitoring (optional) ----
SENTRY_DSN=
LOG_LEVEL=info

# ---- Security ----
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
EMAIL_VERIFY_TTL_HOURS=48
PASSWORD_RESET_TTL_MINUTES=30

# ---- Rate limits ----
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_WRITE_MAX=30
RATE_LIMIT_WINDOW_MINUTES=15
